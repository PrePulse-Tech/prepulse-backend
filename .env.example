# Copy this file to .env and fill in real values: cp .env.example .env
# .env is git-ignored and must NEVER be committed.

# Claude API key used by the AI agent (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/prepulse
DATABASE_URL=

# Shared key that log sources must send when posting logs to the ingest endpoint
INGEST_API_KEY=
